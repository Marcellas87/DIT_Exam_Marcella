    ElectricCar [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C77A12" BGCOLOR="white"><TR><TD BGCOLOR="#FFF4E5" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>ElectricCar</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- batteryKwh: string</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(brand: string, model: string,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;plateNumber: string, batteryKwh: string)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTypeCode(): string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAllowedGarageTypes(): string[]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getBatteryKwh(): ?string</TD></TR></TABLE></TD></TR></TABLE>>];
  }
  subgraph cluster_infra {
    label=<<B>Infrastructure</B>>; fontsize=13; labeljust=l; style="rounded,filled"; fillcolor="#F3F0F880"; color="#6E56A8"; penwidth=1.4;
    Database [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6E56A8" BGCOLOR="white"><TR><TD BGCOLOR="#F3F0F8" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>Database</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ connect(): PDO</U></TD></TR></TABLE></TD></TR></TABLE>>];
    PaymentProofStorage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6E56A8" BGCOLOR="white"><TR><TD BGCOLOR="#F3F0F8" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>PaymentProofStorage</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MAX_BYTES: int = 2097152 {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- EXTENSIONS: array {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- directory: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fromHttpUpload: bool</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(directory: string, fromHttpUpload: bool = true)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validate(file: mixed): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ save(file: mixed): string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ delete(name: string): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findPath(name: string): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- detectType(path: string): ?int</TD></TR></TABLE></TD></TR></TABLE>>];
  }
  { rank=same; AuthService; TenantService; GarageService; RentalService; ExtensionService; ReportService; }
