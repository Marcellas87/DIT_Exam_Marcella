  }
  subgraph cluster_domain {
    label=<<B>Domain  (vehicle class tree)</B>>; fontsize=13; labeljust=l; style="rounded,filled"; fillcolor="#FFF4E580"; color="#C77A12"; penwidth=1.4;
    Vehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C77A12" BGCOLOR="white"><TR><TD BGCOLOR="#FFF4E5" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><FONT POINT-SIZE="13"><I><B>Vehicle</B></I></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_BICYCLE: string = &#x27;bicycle&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_MOTORBIKE: string = &#x27;motorbike&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_CAR: string = &#x27;car&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_ELECTRIC_CAR: string = &#x27;electric_car&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ GARAGE_BICYCLE: string = &#x27;bicycle&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ GARAGE_CAR: string = &#x27;car&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ GARAGE_ELECTRIC_CAR: string = &#x27;electric car&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- brand: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- model: string</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(brand: string, model: string)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getTypeCode(): string</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getAllowedGarageTypes(): string[]</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getBrand(): string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getModel(): string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getPlateNumber(): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getBatteryKwh(): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getBatteryHundredths(): ?int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ canUse(garageTypeName: string): bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ createFromInput(data: array): Vehicle</U></TD></TR></TABLE></TD></TR></TABLE>>];
    Bicycle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C77A12" BGCOLOR="white"><TR><TD BGCOLOR="#FFF4E5" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>Bicycle</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTypeCode(): string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAllowedGarageTypes(): string[]</TD></TR></TABLE></TD></TR></TABLE>>];
    PlatedVehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C77A12" BGCOLOR="white"><TR><TD BGCOLOR="#FFF4E5" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><FONT POINT-SIZE="13"><I><B>PlatedVehicle</B></I></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- plateNumber: string</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(brand: string, model: string, plateNumber: string)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getPlateNumber(): ?string</TD></TR></TABLE></TD></TR></TABLE>>];
