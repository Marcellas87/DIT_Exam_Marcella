    TenantService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>TenantService</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ DECISIONS: string[] {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pdo: PDO</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(pdo: PDO)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findPending(): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ decideRegistration(userId: int, decision: string): bool</TD></TR></TABLE></TD></TR></TABLE>>];
    GarageService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>GarageService</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pdo: PDO</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(pdo: PDO)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findTypes(): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findSummary(): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createBatch(input: array): array</TD></TR></TABLE></TD></TR></TABLE>>];
    RentalService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>RentalService</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pdo: PDO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- storage: PaymentProofStorage</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(pdo: PDO, storage: PaymentProofStorage)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findAvailableGarages(vehicleType: string, today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ previewRental(input: array, today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createRental(tenantId: int, input: array, file: mixed,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ refreshGarageStatuses(today: DateTimeImmutable): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findByTenant(tenantId: int): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findProofName(rentalId: int, userId: int, role: string): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- validateInput(input: array, today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- getGarageTypesFor(vehicleType: string): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- findGarage(garageId: string, lock: bool): ?array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- checkGarageType(vehicle: Vehicle, garage: array): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- checkGarageFree(garageId: string, start: DateTimeImmutable,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;end: DateTimeImmutable): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- isVehicleBusy(vehicleId: int, start: DateTimeImmutable,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;end: DateTimeImmutable): bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- findOrCreateVehicle(vehicle: Vehicle): ?array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- findVehicleForPricing(typedVehicle: Vehicle): Vehicle</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- calculateTotalsFor(vehicle: Vehicle, garage: array, checked: array): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- isAcceptedTenant(tenantId: int): bool</TD></TR></TABLE></TD></TR></TABLE>>];
    ExtensionService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>ExtensionService</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pdo: PDO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- storage: PaymentProofStorage</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(pdo: PDO, storage: PaymentProofStorage)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findActiveRentals(today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findActiveRental(rentalId: int, today: DateTimeImmutable): ?array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateExtraAmount(rentalId: int, newEnd: string,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ extendRental(adminId: int, rentalId: int, newEnd: string,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160;&#160;&#160;&#160;&#160;&#160;file: mixed, today: DateTimeImmutable): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findProofName(extensionId: int, userId: int, role: string): ?string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ findByRental(rentalId: int): array</TD></TR></TABLE></TD></TR></TABLE>>];
    ReportService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>ReportService</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pdo: PDO</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ __construct(pdo: PDO)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buildMonthlyReport(year: int): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buildDailyReport(year: int, month: int): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buildGarageTypeReport(): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buildTenantReport(): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ sumRows(rows: array): array</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- runGroupedQuery(groupExpr: string, where: string, args: array): array</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fillEmptyGroups(labels: array, rows: array): array</TD></TR></TABLE></TD></TR></TABLE>>];
  }
  subgraph cluster_rules {
    label=<<B>Rules and validators  (pure PHP, no database, unit tested)</B>>; fontsize=13; labeljust=l; style="rounded,filled"; fillcolor="#EEF7EC80"; color="#3C8A3C"; penwidth=1.4;
    RentalRules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C8A3C" BGCOLOR="white"><TR><TD BGCOLOR="#EEF7EC" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>RentalRules</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_DAILY: string = &#x27;daily&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ TYPE_MONTHLY: string = &#x27;monthly&#x27; {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MONTHLY_MULTIPLIER: int = 25 {readOnly}</U></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ getMaxDailyDays(start: DateTimeImmutable): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ validate(data: array, start: DateTimeImmutable): array</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ calculateEndDate(start: DateTimeImmutable, rentalType: string,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160;&#160;&#160;&#160;&#160;&#160;days: ?int): DateTimeImmutable</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ calculateRentalCents(dailyCents: int, rentalType: string, days: ?int): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ calculateChargingFeeCents(vehicle: Vehicle, garageTypeName: string,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160;&#160;&#160;&#160;&#160;&#160;kwhPriceCents: ?int): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ calculateTotals(vehicle: Vehicle, garageTypeName: string, dailyPrice: string,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160;&#160;&#160;&#160;&#160;&#160;kwhPrice: ?string, rentalType: string, days: ?int): array</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ convertToCents(amount: string): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ formatCents(cents: int): string</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ validateNewEnd(newEnd: string, oldEnd: DateTimeImmutable): ?string</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ calculateExtensionCents(dailyCents: int, oldEnd: DateTimeImmutable,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160;&#160;&#160;&#160;&#160;&#160;newEnd: DateTimeImmutable): int</U></TD></TR></TABLE></TD></TR></TABLE>>];
    VehicleValidator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C8A3C" BGCOLOR="white"><TR><TD BGCOLOR="#EEF7EC" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>VehicleValidator</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- TYPES: string[] {readOnly}</U></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ validate(data: array): array</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ normalizePlate(plate: string): string</U></TD></TR></TABLE></TD></TR></TABLE>>];
    RegistrationValidator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C8A3C" BGCOLOR="white"><TR><TD BGCOLOR="#EEF7EC" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>RegistrationValidator</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ NIK_LENGTH: int = 16 {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MIN_PASSWORD_LENGTH: int = 8 {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MAX_PASSWORD_LENGTH: int = 72 {readOnly}</U></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ validate(data: array): array</U></TD></TR></TABLE></TD></TR></TABLE>>];
    GarageBatchValidator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C8A3C" BGCOLOR="white"><TR><TD BGCOLOR="#EEF7EC" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><FONT POINT-SIZE="13"><B>GarageBatchValidator</B></FONT></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ MAX_COUNT: int = 999 {readOnly}</U></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ validate(data: array, typeName: string): array</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- isMoney(value: string): bool</U></TD></TR></TABLE></TD></TR></TABLE>>];
