  legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR><TR><TD ALIGN="LEFT">+  public    -  private</TD><TD ALIGN="LEFT"><U>underlined</U> = static</TD></TR><TR><TD ALIGN="LEFT"><I>italic</I> = abstract</TD><TD ALIGN="LEFT">{readOnly} = class constant</TD></TR><TR><TD ALIGN="LEFT">— ▷  inheritance (extends)</TD><TD ALIGN="LEFT">◇— &gt;  aggregation (injected object)</TD></TR><TR><TD ALIGN="LEFT">- - &gt;  dependency («use» / «create»)</TD><TD ALIGN="LEFT">«final» = cannot be extended</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">PDO and DateTimeImmutable are PHP built-in classes. Pages (*.php in the root) create the services;<BR ALIGN="LEFT"/>admin_reports.php uses ReportInput. helpers.php holds functions only (no class).<BR ALIGN="LEFT"/>Vehicle and RentalRules / VehicleValidator use each other (battery in cents, plate cleaning).<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PaymentProofStorage -> legend [style=invis];
