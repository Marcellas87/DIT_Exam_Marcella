digraph G {
  graph [rankdir=TB, splines=spline, nodesep=0.45, ranksep=0.9, fontname="DejaVu Sans", pad=0.4, label=<<B>Garage Rental — UML Class Diagram</B><BR/><FONT POINT-SIZE="11">PHP 8 · src/ · 20 classes</FONT>>, labelloc=t, fontsize=20, bgcolor="white", newrank=true];
