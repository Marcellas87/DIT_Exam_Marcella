  edge [fontname="DejaVu Sans", fontsize=9.5, color="#555555", fontcolor="#444444"];
  subgraph cluster_services {
    label=<<B>Services  (database access through PDO, prepared statements)</B>>; fontsize=13; labeljust=l; style="rounded,filled"; fillcolor="#EAF2FB80"; color="#2F6DB5"; penwidth=1.4;
